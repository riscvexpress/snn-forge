{
  "preprocess": {
    "input": "mnist_opendataset",
    "timesteps": 4,
    "step_generation": "direct"
  },

  "train": {
    "epoch": 10,
    "kfold": 5,
    "repeat": 1
  },

  "global": {
    "input_size": [28, 28],
    "input_channels": 1,
    "output_classes": 10,
    "neuron_type": "ws8"
  },

  "nodes": [
    // 28x28x1 -> 28x28x16
    {
      "name": "conv2d_1",
      "type": "Conv2d",
      "in_channels": 1,
      "out_channels": 16,
      "kernel_size": 3,
      "stride": 1,
      "padding": 1
      // "bias": false
    },
    {
      "name": "leaky_1",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // ---------------------------
    // 28x28x16 -> 28x28x16
    {
      "name": "conv2d_2",
      "type": "Conv2d",
      "in_channels": 16,
      "out_channels": 16,
      "kernel_size": 3,
      "stride": 1,
      "padding": 1
      // "bias": false
    },
    {
      "name": "leaky_2",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // 28x28x16 -> 28x28x16
    {
      "name": "conv2d_3",
      "type": "Conv2d",
      "in_channels": 16,
      "out_channels": 16,
      "kernel_size": 3,
      "stride": 1,
      "padding": 1
      // "bias": false
    },

    // 28x28x16 + 28x28x16 -> 28x28x16
    {
      "name": "shortcut_1",
      "type": "Shortcut",
      "skip_from": "leaky_1",
      "op": "Conv2d",
      "in_channels": 16,
      "out_channels": 16,
      "kernel_size": 1,
      "stride": 1,
      "padding": 0
      // "groups": 1
    },
    {
      "name": "leaky_3",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // ---------------------------
    // 28x28x16 -> 14x14x32
    {
      "name": "conv2d_4",
      "type": "Conv2d",
      "in_channels": 16,
      "out_channels": 32,
      "kernel_size": 3,
      "stride": 2,
      "padding": 1
      // "bias": false
    },
    {
      "name": "leaky_4",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // 14x14x32 -> 14x14x32
    {
      "name": "conv2d_5",
      "type": "Conv2d",
      "in_channels": 32,
      "out_channels": 32,
      "kernel_size": 3,
      "stride": 1,
      "padding": 1
      // "bias": false
    },

    // (28x28x16 -> 14x14x32) + 14x14x32 -> 14x14x32
    {
      "name": "shortcut_2",
      "type": "Shortcut",
      "skip_from": "leaky_3",
      "op": "Conv2d",
      "in_channels": 16,
      "out_channels": 32,
      "kernel_size": 1,
      "stride": 2,
      "padding": 0
      // "groups": 1
    },
    {
      "name": "leaky_5",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // -----------------------
    // 14x14x32 -> 6272
    {"name": "flatten_1", "type": "Flatten"},
    {
      "name": "linear_1",
      "type": "Linear",
      "in_features": 6272,
      "out_features": 10
    },
    {
      "name": "leaky_6",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    }
  ]
}
