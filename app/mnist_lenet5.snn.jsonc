{
  "preprocess": {
    "input": "mnist_opendataset",
    "timesteps": 4,
    "step_generation": "direct"
  },

  "train": {
    "epoch": 10,
    "kfold": 5,
    "repeat": 1
  },

  "global": {
    "input_size": [28, 28],
    "input_channels": 1,
    "output_classes": 10,
    "neuron_type": "ws8"
  },

  "nodes": [
    // --------------------------------------------------
    // Input: 1 x 28 x 28
    // Conv1: 1 x 28 x 28 -> 6 x 24 x 24
    // --------------------------------------------------
    {
      "name": "conv2d_1",
      "type": "Conv2d",
      "in_channels": 1,
      "out_channels": 6,
      "kernel_size": 5,
      "stride": 1,
      "padding": 0
      // "bias": true
    },

    // 6 x 24 x 24 -> 6 x 12 x 12
    {
      "name": "maxpool2d_1",
      "type": "MaxPool2d",
      "kernel_size": 2,
      "stride": 2,
      "padding": 0
    },
    {
      "name": "leaky_1",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // --------------------------------------------------
    // Conv2: 6 x 12 x 12 -> 16 x 8 x 8
    // --------------------------------------------------
    {
      "name": "conv2d_2",
      "type": "Conv2d",
      "in_channels": 6,
      "out_channels": 16,
      "kernel_size": 5,
      "stride": 1,
      "padding": 0
      // "bias": true
    },

    // 16 x 8 x 8 -> 16 x 4 x 4
    {
      "name": "maxpool2d_2",
      "type": "MaxPool2d",
      "kernel_size": 2,
      "stride": 2,
      "padding": 0
    },
    {
      "name": "leaky_2",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // --------------------------------------------------
    // 16 x 4 x 4 -> 256
    // --------------------------------------------------
    {"name": "flatten_1", "type": "Flatten"},

    // --------------------------------------------------
    // LeNet-5 fully connected layer 1
    // 256 -> 120
    // --------------------------------------------------
    {
      "name": "linear_1",
      "type": "Linear",
      "in_features": 256,
      "out_features": 120
    },
    {
      "name": "leaky_3",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // --------------------------------------------------
    // LeNet-5 fully connected layer 2
    // 120 -> 84
    // --------------------------------------------------
    {
      "name": "linear_2",
      "type": "Linear",
      "in_features": 120,
      "out_features": 84
    },
    {
      "name": "leaky_4",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    },

    // --------------------------------------------------
    // Output layer
    // 84 -> 10
    // --------------------------------------------------
    {
      "name": "linear_3",
      "type": "Linear",
      "in_features": 84,
      "out_features": 10
    },
    {
      "name": "leaky_5",
      "type": "Leaky",
      "beta": 1.0,
      // "threshold": 1.0
      "reset_mechanism": "subtract",
      "learn_threshold": false
    }
  ]
}
